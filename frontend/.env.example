# MonadPlaysPokemon contract address (deployed to Monad Testnet)
VITE_CONTRACT_ADDRESS=0xYOUR_CONTRACT_ADDRESS_HERE

# Monad Testnet RPC URL
VITE_RPC_URL=https://testnet-rpc.monad.xyz

# Indexer Socket.io URL
VITE_INDEXER_URL=http://localhost:3001

# Optional Privy configuration. Leave empty to use Mera and injected wallets only.
# Get your App ID from https://console.privy.io
VITE_PRIVY_APP_ID=

# EIP-7702 Relay Configuration (experimental gasless voting)
# Set VITE_RELAY_ENABLED=true to enable gasless voting via relay
VITE_RELAY_ENABLED=false
VITE_DELEGATION_CONTRACT=0xYOUR_DELEGATION_CONTRACT_ADDRESS_HERE
VITE_RELAY_API_URL=http://localhost:3001

# Vote button cooldown in milliseconds (default: 500)
# Minimum interval between clicks; pending votes are also reconciled before another submission.
VITE_VOTE_COOLDOWN_MS=500

# Mera passkey accounts (requires Node 24 to build)
# Set false to disable enrollment and passkey voting while keeping account recovery available.
VITE_MERA_ENABLED=true
# Exact production hostname, without scheme or port. Use localhost for local development.
VITE_MERA_RP_ID=localhost
VITE_MERA_RP_NAME=Monad Plays Pokemon
