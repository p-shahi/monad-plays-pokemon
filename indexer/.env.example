# Monad WebSocket RPC URL
RPC_URL=wss://testnet-rpc.monad.xyz
HTTP_RPC_URL=https://testnet-rpc.monad.xyz
CHAIN_ID=10143

# Deployed MonadPlaysPokemon contract address
CONTRACT_ADDRESS=0xYOUR_CONTRACT_ADDRESS_HERE

# Voting window size in blocks (default: 1)
WINDOW_SIZE=1

# Socket.io server port (default: 3001)
PORT=3001

# Save directory for game state persistence (default: ./saves)
# For Railway: Set to volume mount path, e.g., /app/saves
SAVE_DIR=

# EIP-7702 Relay Configuration (experimental gasless voting)
# Set RELAY_ENABLED=true to enable gasless voting via relay
RELAY_ENABLED=false
RELAY_PRIVATE_KEY=
DELEGATION_CONTRACT=

# Sponsorship limits; gas price is in gwei, balances and daily budget are in MON.
# The daily budget uses UTC receipt dates and includes all pending reservations.
RELAY_MAX_GAS_PRICE=200
RELAY_SIGNATURE_VALIDITY=300
RELAY_DAILY_BUDGET_MON=1
RELAY_MIN_BALANCE_MON=0.01
RELAY_MAX_PENDING=64
RELAY_ADDRESS_LIMIT_PER_MINUTE=60
RELAY_IP_LIMIT_PER_MINUTE=120
# Comma-separated trusted proxy IPs/CIDRs. Empty means forwarded IP headers are ignored.
RELAY_TRUST_PROXY=
